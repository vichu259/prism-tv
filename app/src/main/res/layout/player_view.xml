<?xml version="1.0" encoding="utf-8"?>
<!--
  TextureView instead of the default SurfaceView: on MediaTek TV chips the SurfaceView path can
  ignore the decoder's crop of 1088-line HD frames to 1080, leaving a flickering strip of padding
  along the bottom. TextureView composites through the GPU and applies the crop correctly.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fit"
    app:shutter_background_color="@android:color/black"
    app:keep_content_on_player_reset="true" />
